    "@angular/platform-browser": "^20.3.20",
    "@angular/platform-browser-dynamic": "^20.3.20",
    "@angular/router": "^20.3.20",
    "@daily-co/daily-js": "^0.85.0",
    "@ngneat/transloco": "6.0.4",
    "@tailwindcss/postcss": "^4.1.8",
