{
  "name": "auth-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:dev": "ng serve --host 0.0.0.0 --port 8802",
    "start:dev:cert": "ng serve --host 0.0.0.0 --port 8802 --ssl true --ssl-cert ./certs/cert.pem --ssl-key ./certs/key.pem --disable-host-check",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
